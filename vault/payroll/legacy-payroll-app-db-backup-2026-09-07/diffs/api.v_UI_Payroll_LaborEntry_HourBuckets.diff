+WHEN ISNULL(nu.IsNonUnionAdminHourlyCA, 0) = 1
+THEN 0
+
+WHEN ISNULL(sb.Pricing_Slice_Count, 0) > 0
+THEN ISNULL(sb.Actual_Hrs_H2x, 0)
+
+WHEN ISNULL(dc.IsSpecialSaturday, 0) = 1
+THEN
+ISNULL(pc.Hrs_ST, 0)
++ ISNULL(pc.Hrs_OT, 0)
++ ISNULL(pc.Hrs_DT, 0)
+
+ELSE 0
+END
+),
+
+/***************************************************************
+H3x
+
+L12 Holiday 3X classification does not apply to
+Non-Union Admin Hourly.
+***************************************************************/
+Actual_Hrs_H3x =
+CONVERT
+(
+decimal(10,2),
+CASE
+WHEN ISNULL(nu.IsNonUnionAdminHourlyCA, 0) = 1
+THEN 0
+
+WHEN ISNULL(sb.Pricing_Slice_Count, 0) > 0
+THEN ISNULL(sb.Actual_Hrs_H3x, 0)
+
+WHEN ISNULL(dc.IsHoliday, 0) = 1
+THEN
+ISNULL(pc.Hrs_ST, 0)
++ ISNULL(pc.Hrs_OT, 0)
++ ISNULL(pc.Hrs_DT, 0)
+
+ELSE 0
+END
+),
+
+Rule_Hrs_ST =
+CONVERT
+(
+decimal(10,2),
+ISNULL(rbc.Rule_Hrs_ST, 0)
+),
+
+Rule_Hrs_OT =
+CONVERT
+(
+decimal(10,2),
+ISNULL(rbc.Rule_Hrs_OT, 0)
+),
+
+Rule_Hrs_DT =
+CONVERT
+(
+decimal(10,2),
+ISNULL(rbc.Rule_Hrs_DT, 0)
+),
+
+Rule_Hrs_H2x =
+CONVERT
+(
+decimal(10,2),
+ISNULL(rbc.Rule_Hrs_H2x, 0)
+),
+
+Rule_Hrs_H3x =
+CONVERT
+(
+decimal(10,2),
+ISNULL(rbc.Rule_Hrs_H3x, 0)
+),
+
+Expected_Payable_Hrs =
+CONVERT
+(
+decimal(10,2),
+ISNULL(pc.Act_Total_Hrs, 0)
++ ISNULL(pc.Gap_Hrs_Total, 0)
 + ISNULL(rhc.Rule_Hrs_ShiftAdd, 0)
 + ISNULL(rhc.Rule_Hrs_WTL_Net, 0)
-AS decimal(10,2)),
+),
+
+Rule_Hrs_Gap =
+CONVERT
+(
+decimal(10,2),
+ISNULL(rhc.Rule_Hrs_Gap, 0)
+),
+
+Rule_Hrs_ShiftAdd =
+CONVERT
+(
+decimal(10,2),
+ISNULL(rhc.Rule_Hrs_ShiftAdd, 0)
+),
+
+Rule_Hrs_WTL_Net =
+CONVERT
+(
+decimal(10,2),
+ISNULL(rhc.Rule_Hrs_WTL_Net, 0)
+),
 
 Rest_Premium_Hrs_Affected =
-CAST(ISNULL(rhc.Rest_Premium_Hrs_Affected, ISNULL(pc.Rest_Premium_Hrs, 0)) AS decimal(10,2)),
+CONVERT
+(
+decimal(10,2),
+ISNULL
+(
+rhc.Rest_Premium_Hrs_Affected,
+ISNULL(pc.Rest_Premium_Hrs, 0)
+)
+),
 
 Gross =
-CAST(ISNULL(pc.Final_Gross_Pay, 0) AS decimal(19,4)),
+CONVERT
+(
+decimal(19,4),
+ISNULL(pc.Final_Gross_Pay, 0)
+),
 
 Rule_Amt_Gap =
-CAST(ISNULL(rhc.Rule_Amt_Gap, ISNULL(pc.Pay_Gap_Add, 0)) AS decimal(19,4)),
+CONVERT
+(
+decimal(19,4),
+ISNULL
+(
+rhc.Rule_Amt_Gap,
+ISNULL(pc.Pay_Gap_Add, 0)
+)
+),
 
 Rule_Amt_ShiftAdd =
-CAST(ISNULL(rhc.Rule_Amt_ShiftAdd, 0) AS decimal(19,4)),
+CONVERT
+(
+decimal(19,4),
+ISNULL(rhc.Rule_Amt_ShiftAdd, 0)
+),
 
 Rule_Amt_WTL =
-CAST(ISNULL(rhc.Rule_Amt_WTL, 0) AS decimal(19,4)),
+CONVERT
+(
+decimal(19,4),
+ISNULL(rhc.Rule_Amt_WTL, 0)
+),
 
 Rest_Premium_Amt =
-CAST(ISNULL(rhc.Rest_Premium_Amt, ISNULL(pc.Pay_Rest_Add, 0)) AS decimal(19,4)),
+CONVERT
+(
+decimal(19,4),
+ISNULL
+(
+rhc.Rest_Premium_Amt,
+ISNULL(pc.Pay_Rest_Add, 0)
+)
+)
+
+FROM fms.Payroll_Calculated AS pc
+
+LEFT JOIN SliceBuckets AS sb
+ON sb.LaborPayrollID = pc.LaborPayrollID
+
+LEFT JOIN DayClassification AS dc
+ON dc.LaborPayrollID = pc.LaborPayrollID
+
+LEFT JOIN NonUnionAdminHourlyCA AS nu
+ON nu.LaborPayrollID = pc.LaborPayrollID
+
+LEFT JOIN RuleHourComponents AS rhc
+ON rhc.LaborPayrollID = pc.LaborPayrollID
+
+LEFT JOIN RuleBucketComponents AS rbc
+ON rbc.LaborPayrollID = pc.LaborPayrollID
+)
+
+SELECT
+c.CalcID,
+c.LaborPayrollID,
+c.JobTicketID,
+c.JobCode,
+c.EmpID,
+c.Employee_Name,
+c.WorkDate,
+
+c.Actual_Hrs,
+
+Payable_Hrs =
+CONVERT
+(
+decimal(10,2),
+c.Actual_Hrs_ST
++ c.Actual_Hrs_OT
++ c.Actual_Hrs_DT
++ c.Actual_Hrs_H2x
++ c.Actual_Hrs_H3x
++ c.Rule_Hrs_ST
++ c.Rule_Hrs_OT
++ c.Rule_Hrs_DT
++ c.Rule_Hrs_H2x
++ c.Rule_Hrs_H3x
+),
+
+c.Expected_Payable_Hrs,
+
+Bucketed_Payable_Hrs =
+CONVERT
+(
+decimal(10,2),
+c.Actual_Hrs_ST
++ c.Actual_Hrs_OT
++ c.Actual_Hrs_DT
++ c.Actual_Hrs_H2x
++ c.Actual_Hrs_H3x
++ c.Rule_Hrs_ST
++ c.Rule_Hrs_OT
++ c.Rule_Hrs_DT
++ c.Rule_Hrs_H2x
++ c.Rule_Hrs_H3x
+),
+
+Hrs_ST =
+CONVERT
+(
+decimal(10,2),
+c.Actual_Hrs_ST + c.Rule_Hrs_ST
+),
+
+Hrs_OT =
+CONVERT
+(
+decimal(10,2),
+c.Actual_Hrs_OT + c.Rule_Hrs_OT
+),
+
+Hrs_DT =
+CONVERT
+(
+decimal(10,2),
+c.Actual_Hrs_DT + c.Rule_Hrs_DT
+),
+
+Hrs_H2x =
+CONVERT
+(
+decimal(10,2),
+c.Actual_Hrs_H2x + c.Rule_Hrs_H2x
+),
+
+Hrs_H3x =
+CONVERT
+(
+decimal(10,2),
+c.Actual_Hrs_H3x + c.Rule_Hrs_H3x
+),
+
+c.Rule_Hrs_Gap,
+c.Rule_Hrs_ShiftAdd,
+c.Rule_Hrs_WTL_Net,
+
+Rule_Hrs_Total =
+CONVERT
+(
+decimal(10,2),
+c.Rule_Hrs_Gap
++ c.Rule_Hrs_ShiftAdd
++ c.Rule_Hrs_WTL_Net
+),
+
+c.Rest_Premium_Hrs_Affected,
+
+c.Gross,
+c.Rule_Amt_Gap,
+c.Rule_Amt_ShiftAdd,
+c.Rule_Amt_WTL,
+c.Rest_Premium_Amt,
 
 Bucket_Hrs_TieOut_Difference =
-CAST(
-(
-ISNULL(sb.Actual_Hrs_ST, 0)
-+ ISNULL(sb.Actual_Hrs_OT, 0)
-+ ISNULL(sb.Actual_Hrs_DT, 0)
-+ ISNULL(sb.Actual_Hrs_H2x, 0)
-+ ISNULL(sb.Actual_Hrs_H3x, 0)
-+ ISNULL(rbc.Rule_Hrs_ST, 0)
-+ ISNULL(rbc.Rule_Hrs_OT, 0)
-+ ISNULL(rbc.Rule_Hrs_DT, 0)
-+ ISNULL(rbc.Rule_Hrs_H2x, 0)
-+ ISNULL(rbc.Rule_Hrs_H3x, 0)
-)
--
-(
-ISNULL(sb.Actual_Hrs_ST, 0)
-+ ISNULL(rbc.Rule_Hrs_ST, 0)
-+ ISNULL(sb.Actual_Hrs_OT, 0)
-+ ISNULL(rbc.Rule_Hrs_OT, 0)
-+ ISNULL(sb.Actual_Hrs_DT, 0)
-+ ISNULL(rbc.Rule_Hrs_DT, 0)
-+ ISNULL(sb.Actual_Hrs_H2x, 0)
-+ ISNULL(rbc.Rule_Hrs_H2x, 0)
-+ ISNULL(sb.Actual_Hrs_H3x, 0)
-+ ISNULL(rbc.Rule_Hrs_H3x, 0)
-)
-AS decimal(10,2)),
+CONVERT
+(
+decimal(10,2),
+(
+c.Actual_Hrs_ST
++ c.Actual_Hrs_OT
++ c.Actual_Hrs_DT
++ c.Actual_Hrs_H2x
++ c.Actual_Hrs_H3x
++ c.Rule_Hrs_ST
++ c.Rule_Hrs_OT
++ c.Rule_Hrs_DT
++ c.Rule_Hrs_H2x
++ c.Rule_Hrs_H3x
+)
+- c.Expected_Payable_Hrs
+),
 
 Bucket_Hrs_TieOut_Status =
-CAST('Balanced' AS varchar(20)),
+CONVERT
+(
+varchar(20),
+CASE
+WHEN ABS
+(
+(
+c.Actual_Hrs_ST
++ c.Actual_Hrs_OT
++ c.Actual_Hrs_DT
++ c.Actual_Hrs_H2x
++ c.Actual_Hrs_H3x
++ c.Rule_Hrs_ST
++ c.Rule_Hrs_OT
++ c.Rule_Hrs_DT
++ c.Rule_Hrs_H2x
++ c.Rule_Hrs_H3x
+)
+- c.Expected_Payable_Hrs
+) < 0.01
+THEN 'Balanced'
+
+ELSE 'Out of balance'
+END
+),
 
 Has_H2x =
-CAST(CASE
-WHEN ISNULL(sb.Actual_Hrs_H2x, 0) + ISNULL(rbc.Rule_Hrs_H2x, 0) <> 0
-THEN 1 ELSE 0
-END AS bit),
+CONVERT
+(
+bit,
+CASE
+WHEN c.Actual_Hrs_H2x + c.Rule_Hrs_H2x <> 0
+THEN 1
+ELSE 0
+END
+),
 
 Has_H3x =
-CAST(CASE
-WHEN ISNULL(sb.Actual_Hrs_H3x, 0) + ISNULL(rbc.Rule_Hrs_H3x, 0) <> 0
-THEN 1 ELSE 0
-END AS bit)
-FROM fms.Payroll_Calculated pc
-LEFT JOIN SliceBuckets sb
-ON sb.LaborPayrollID = pc.LaborPayrollID
-LEFT JOIN RuleHourComponents rhc
-ON rhc.LaborPayrollID = pc.LaborPayrollID
-LEFT JOIN RuleBucketComponents rbc
-ON rbc.LaborPayrollID = pc.LaborPayrollID;
-
+CONVERT
+(
+bit,
+CASE
+WHEN c.Actual_Hrs_H3x + c.Rule_Hrs_H3x <> 0
+THEN 1
+ELSE 0
+END
+),
+
+c.Bucket_Source,
+c.Has_Pricing_Slices,
+c.Pricing_Slice_Count,
+c.Pricing_Slice_Hours,
+c.Bucket_Source_Review_Flag,
+c.Bucket_Source_Review_Message
+
+FROM Combined AS c;
