{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.claude/settings.schema.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(pnpm *)",
      "Bash(npx prisma *)",
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git rebase *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git remote -v)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(cat package.json)",
      "Bash(cat tsconfig.json)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(* > /etc/*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Read(//**/.*env*)",
      "Read(//**/*secret*)",
      "Read(//**/*credential*)",
      "Edit(//**/.*env*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'AI-DLC triage (CLAUDE.md, GUIDE.md §2): if this prompt asks to build, change or fix code, then before editing anything name the ticket (or say there is none) and state its path: A = new behaviour or needs product intent (full loop, starting with tcg-elaborator); B = bug against specified behaviour (repro, tcg-executor, tcg-analyst); C = small stated change (just build). Any path becomes A once something nobody specified must be decided. Questions, debugging, reviews and exploration: ignore this.'"
          }
        ]
      }
    ]
  },
  "codeStyle": {
    "typescript": {
      "formatter": "prettier",
      "linter": "eslint",
      "strict": true,
      "noAny": true
    }
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },
  "sandbox": {
    "filesystem": {
      "allowRead": ["/tmp/.nx", "~/.nx"],
      "allowWrite": ["/tmp/.nx", "~/.nx"]
    },
    "network": {
      "allowUnixSockets": ["/tmp/.nx", "~/.nx"]
    }
  }
}
