{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.claude/settings.schema.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(pnpm *)",
      "Bash(npx prisma *)",
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git rebase *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git remote -v)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(cat package.json)",
      "Bash(cat tsconfig.json)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(* > /etc/*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Read(//**/.*env*)",
      "Read(//**/*secret*)",
      "Read(//**/*credential*)",
      "Edit(//**/.*env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edits.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-shared-ui.mjs\""
          }
        ]
      }
    ]
  },
  "codeStyle": {
    "typescript": {
      "formatter": "prettier",
      "linter": "eslint",
      "strict": true,
      "noAny": true
    }
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },
  "sandbox": {
    "filesystem": {
      "allowRead": [
        "/tmp/.nx",
        "~/.nx"
      ],
      "allowWrite": [
        "/tmp/.nx",
        "~/.nx"
      ]
    },
    "network": {
      "allowUnixSockets": [
        "/tmp/.nx",
        "~/.nx"
      ]
    }
  }
}
