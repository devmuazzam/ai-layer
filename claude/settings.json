{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.claude/settings.schema.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(pnpm *)",
      "Bash(npx prisma *)",
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(cat package.json)",
      "Bash(cat tsconfig.json)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(* > /etc/*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Read(//**/.*env*)",
      "Read(//**/*secret*)",
      "Read(//**/*credential*)",
      "Edit(//**/.*env*)"
    ]
  },
  "codeStyle": {
    "typescript": {
      "formatter": "prettier",
      "linter": "eslint",
      "strict": true,
      "noAny": true
    }
  }
}
