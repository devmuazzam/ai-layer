.DS_Store
claude/settings.local.json
*.backup-*

# Generated by setup.sh: a flat discovery index of symlinks into aidlc/agents/, which is
# where Claude Code looks for subagents. The phase directories are the source of truth, so
# these are derived — tracking them would let two machines disagree about a link that
# setup.sh rebuilds correctly on every run.
claude/agents/

# Obsidian per-person UI state — not shared.
# Patterns are **/-prefixed because a pattern containing a slash is anchored to
# this .gitignore's directory (.ai/), and the vault lives at .ai/vault/.obsidian/.
# The rest of .obsidian/ (app.json, appearance.json, core-plugins.json,
# community-plugins.json) stays tracked so vault settings are shared.
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/graph.json
**/.obsidian/cache
